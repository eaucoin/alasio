    {
      "id": 11,
      "type": "timeseries",
      "title": "The Valkeys' memory",
      "gridPos": {
        "x": 16,
        "y": 36,
        "w": 8,
        "h": 8
      },
      "description": "The memory each Valkey's data takes, workspace storage's metadata's and the object store's filer store's, against its limit, past which it refuses writes.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "lake"
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "lake"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "timeseries",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "select time_bucket(to_milliseconds(${__interval_ms}), TimeUnix) as time,\ncoalesce(ResourceAttributes['server.address'], 'Valkey') || case MetricName when 'redis.memory.used' then ' used' else ' limit' end as memory, max(Value) as bytes\nfrom otel.metrics_gauge where MetricName in ('redis.memory.used', 'redis.maxmemory') and TimeUnix >= epoch_ms(${__from}) and TimeUnix < epoch_ms(${__to})\ngroup by all order by 1"
          },
