      "type": "timeseries",
      "title": "Claude Code's tokens",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "description": "By the messages of Claude Code's transcripts, as their last entry counts them.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "lake"
      },
      "interval": "5m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "lake"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "timeseries",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "select time, kind, sum(tokens) as tokens from (\nunpivot (select time_bucket(to_milliseconds(${__interval_ms}), started_at) as time, input_tokens as input, output_tokens as output,\ncache_read_input_tokens as \"cache read\", cache_creation_input_tokens as \"cache written\"\nfrom claude.messages where ${branch:sqlstring} = 'main' and started_at >= epoch_ms(${__from}) and started_at < epoch_ms(${__to}))\non input, output, \"cache read\", \"cache written\" into name kind value tokens)\ngroup by all order by 1"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "kind",
              "text": "kind",
              "type": "string"
            },
            {
              "selector": "tokens",
              "text": "tokens",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "${__field.labels.kind}",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
