{
  "uid": "alasio-stack-health",
  "title": "Stack health",
  "description": "Whether the stack's services answer, whether telemetry reaches the lake, what the stack logs as going wrong, and what its storage holds: from what the stack's collector scrapes and receives.",
  "tags": [
    "alasio"
  ],
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "",
  "schemaVersion": 41,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Services",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Services answering",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 16,
        "h": 8
      },
      "description": "Each service the collector scrapes, up while it answers its scrape (Prometheus's `up`), down while it does not.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "lake"
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "lake"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "timeseries",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "select time_bucket(to_milliseconds(${__interval_ms}), TimeUnix) as time, ServiceName as service, min(Value) as up\nfrom otel.metrics_gauge where MetricName = 'up' and TimeUnix >= epoch_ms(${__from}) and TimeUnix < epoch_ms(${__to})\ngroup by all order by 1"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "service",
              "text": "service",
              "type": "string"
            },
            {
              "selector": "up",
              "text": "up",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ],
          "displayName": "${__field.labels.service}",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Services now",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "description": "Each service's last scrape, in the last ten minutes.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "lake"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "lake"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "select ServiceName as service, arg_max(Value, TimeUnix) as up, max(TimeUnix) as scraped\nfrom otel.metrics_gauge where MetricName = 'up' and TimeUnix > now()::timestamp - interval 10 minute\ngroup by 1 order by 1"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "service",
              "text": "service",
              "type": "string"
            },
            {
              "selector": "up",
              "text": "up",
              "type": "number"
            },
            {
              "selector": "scraped",
              "text": "last scraped",
              "type": "timestamp"
            }
          ]
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "service": 0,
              "up": 1,
              "last scraped": 2
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "up"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "down",
                        "color": "red"
                      },
                      "1": {
                        "text": "up",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Telemetry",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Telemetry arriving",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "description": "Spans, log records and metric points written to the lake, by when they happened. None at all is the intake, or the collector, down.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "lake"
      },
      "interval": "5m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "lake"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "timeseries",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "select time, signal, count(*) as items from (\nselect time_bucket(to_milliseconds(${__interval_ms}), Timestamp) as time, 'spans' as signal from otel.traces where Timestamp >= epoch_ms(${__from}) and Timestamp < epoch_ms(${__to})\nunion all select time_bucket(to_milliseconds(${__interval_ms}), Timestamp), 'log records' from otel.logs where Timestamp >= epoch_ms(${__from}) and Timestamp < epoch_ms(${__to})\nunion all select time_bucket(to_milliseconds(${__interval_ms}), TimeUnix), 'metric points' from otel.metrics_gauge where TimeUnix >= epoch_ms(${__from}) and TimeUnix < epoch_ms(${__to})\nunion all select time_bucket(to_milliseconds(${__interval_ms}), TimeUnix), 'metric points' from otel.metrics_sum where TimeUnix >= epoch_ms(${__from}) and TimeUnix < epoch_ms(${__to})\nunion all select time_bucket(to_milliseconds(${__interval_ms}), TimeUnix), 'metric points' from otel.metrics_histogram where TimeUnix >= epoch_ms(${__from}) and TimeUnix < epoch_ms(${__to})\n) group by all order by 1"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "signal",
              "text": "signal",
              "type": "string"
            },
            {
              "selector": "items",
              "text": "items",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "${__field.labels.signal}",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Telemetry by service",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "description": "Spans and log records, by the service that sent them.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "lake"
      },
      "interval": "5m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "lake"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "timeseries",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "select time, service, count(*) as items from (\nselect time_bucket(to_milliseconds(${__interval_ms}), Timestamp) as time, ServiceName as service from otel.traces where Timestamp >= epoch_ms(${__from}) and Timestamp < epoch_ms(${__to})\nunion all select time_bucket(to_milliseconds(${__interval_ms}), Timestamp), ServiceName from otel.logs where Timestamp >= epoch_ms(${__from}) and Timestamp < epoch_ms(${__to})\n) group by all order by 1"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "service",
              "text": "service",
              "type": "string"
            },
            {
              "selector": "items",
              "text": "items",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "${__field.labels.service}",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Warnings and errors",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 9
      },
      "description": "What the stack's services logged as a warning or worse, the latest first.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "lake"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "lake"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "select Timestamp as time, ServiceName as service, SeverityText as severity, Body as message, TraceId as trace\nfrom otel.logs where SeverityNumber >= 13 and Timestamp >= epoch_ms(${__from}) and Timestamp < epoch_ms(${__to})\norder by Timestamp desc limit 500"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "service",
              "text": "service",
              "type": "string"
            },
            {
              "selector": "severity",
              "text": "severity",
              "type": "string"
            },
            {
              "selector": "message",
              "text": "message",
              "type": "string"
            },
            {
              "selector": "trace",
              "text": "trace",
              "type": "string"
            }
          ]
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "time": 0,
              "service": 1,
              "severity": 2,
              "message": 3,
              "trace": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Storage",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Neon's pageserver",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "description": "The size of alasio's Neon's layers: those the pageserver keeps on its volume, and those it uploaded.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "lake"
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "lake"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "timeseries",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "select time_bucket(to_milliseconds(${__interval_ms}), TimeUnix) as time,\ncase MetricName when 'pageserver_resident_physical_size_global' then 'on its disk' else 'in the object store' end as size, max(Value) as bytes\nfrom otel.metrics_gauge\nwhere MetricName in ('pageserver_resident_physical_size_global', 'pageserver_remote_physical_size_global') and TimeUnix >= epoch_ms(${__from}) and TimeUnix < epoch_ms(${__to})\ngroup by all order by 1"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "size",
              "text": "size",
              "type": "string"
            },
            {
              "selector": "bytes",
              "text": "bytes",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "displayName": "${__field.labels.size}",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Workspaces' JuiceFS",
      "gridPos": {
        "x": 8,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "description": "The space workspace storage's file system uses, as its mounts report it.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "lake"
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "lake"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "timeseries",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "select time_bucket(to_milliseconds(${__interval_ms}), TimeUnix) as time, 'used' as space, max(Value) as bytes\nfrom otel.metrics_gauge where MetricName = 'juicefs_used_space' and TimeUnix >= epoch_ms(${__from}) and TimeUnix < epoch_ms(${__to})\ngroup by all order by 1"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "space",
              "text": "space",
              "type": "string"
            },
            {
              "selector": "bytes",
              "text": "bytes",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "displayName": "${__field.labels.space}",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Valkey's memory",
      "gridPos": {
        "x": 16,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "description": "The memory workspace storage's metadata takes in Valkey, against its limit, past which it refuses writes.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "lake"
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "lake"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "timeseries",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "select time_bucket(to_milliseconds(${__interval_ms}), TimeUnix) as time,\ncase MetricName when 'redis.memory.used' then 'used' else 'limit' end as memory, max(Value) as bytes\nfrom otel.metrics_gauge where MetricName in ('redis.memory.used', 'redis.maxmemory') and TimeUnix >= epoch_ms(${__from}) and TimeUnix < epoch_ms(${__to})\ngroup by all order by 1"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "memory",
              "text": "memory",
              "type": "string"
            },
            {
              "selector": "bytes",
              "text": "bytes",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "displayName": "${__field.labels.memory}",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "The lake's tables",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 8
      },
      "description": "Each table of the lake, its Parquet files and their size. Rows not yet flushed to a file are in the catalog, and counted in rows only.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "lake"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "lake"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "select t.schema_name || '.' || t.table_name as \"table\", i.file_count as files, i.file_size_bytes as bytes,\ni.delete_file_count as delete_files, t.estimated_size as rows\nfrom ducklake_table_info('lake') i join duckdb_tables() t on t.database_name = 'lake' and t.table_name = i.table_name\norder by i.file_size_bytes desc"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "table",
              "text": "table",
              "type": "string"
            },
            {
              "selector": "files",
              "text": "files",
              "type": "number"
            },
            {
              "selector": "bytes",
              "text": "bytes",
              "type": "number"
            },
            {
              "selector": "delete_files",
              "text": "delete files",
              "type": "number"
            },
            {
              "selector": "rows",
              "text": "rows",
              "type": "number"
            }
          ]
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "table": 0,
              "files": 1,
              "bytes": 2,
              "delete files": 3,
              "rows": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "bytes"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}
