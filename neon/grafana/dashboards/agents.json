          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "select time_bucket(to_milliseconds(${__interval_ms}), Timestamp) as time, coalesce(SpanAttributes['alasio.turn.outcome'], StatusCode) as outcome, count(*) as turns\nfrom otel.traces where SpanName = 'alasio.turn' and ServiceName = 'alasio' and coalesce(ResourceAttributes['alasio.branch'], 'main') = ${branch:sqlstring} and Timestamp >= epoch_ms(${__from}) and Timestamp < epoch_ms(${__to}) group by all order by 1"
          },
          "root_selector": "",
