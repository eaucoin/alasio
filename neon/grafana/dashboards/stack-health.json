{
  "uid": "alasio-stack-health",
  "title": "Stack health",
  "description": "Whether the stack's services answer, whether telemetry reaches the lake, what the stack logs as going wrong, and what its storage holds: from what the stack's collector scrapes and receives.",
  "tags": [
    "alasio"
  ],
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "",
  "schemaVersion": 41,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Services",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Services answering",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 16,
        "h": 8
      },
      "description": "Each service the collector scrapes, up while it answers its scrape (Prometheus's `up`), down while it does not.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "lake"
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "lake"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "timeseries",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "select time_bucket(to_milliseconds(${__interval_ms}), TimeUnix) as time, ServiceName as service, min(Value) as up\nfrom otel.metrics_gauge where MetricName = 'up' and TimeUnix >= epoch_ms(${__from}) and TimeUnix < epoch_ms(${__to})\ngroup by all order by 1"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "service",
              "text": "service",
              "type": "string"
            },
            {
              "selector": "up",
              "text": "up",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ],
          "displayName": "${__field.labels.service}",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Services now",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "description": "Each service's last scrape, in the last ten minutes.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "lake"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "lake"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "select ServiceName as service, arg_max(Value, TimeUnix) as up, max(TimeUnix) as scraped\nfrom otel.metrics_gauge where MetricName = 'up' and TimeUnix > now()::timestamp - interval 10 minute\ngroup by 1 order by 1"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "service",
              "text": "service",
              "type": "string"
            },
            {
              "selector": "up",
              "text": "up",
              "type": "number"
            },
            {
              "selector": "scraped",
              "text": "last scraped",
              "type": "timestamp"
            }
          ]
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "service": 0,
              "up": 1,
              "last scraped": 2
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "up"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "down",
                        "color": "red"
                      },
                      "1": {
                        "text": "up",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Telemetry",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Telemetry arriving",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "description": "Spans, log records and metric points written to the lake, by when they happened. None at all is the intake, the log, or the collector, down.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "lake"
      },
      "interval": "5m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "lake"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "timeseries",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "select time, signal, count(*) as items from (\nselect time_bucket(to_milliseconds(${__interval_ms}), Timestamp) as time, 'spans' as signal from otel.traces where Timestamp >= epoch_ms(${__from}) and Timestamp < epoch_ms(${__to})\nunion all select time_bucket(to_milliseconds(${__interval_ms}), Timestamp), 'log records' from otel.logs where Timestamp >= epoch_ms(${__from}) and Timestamp < epoch_ms(${__to})\nunion all select time_bucket(to_milliseconds(${__interval_ms}), TimeUnix), 'metric points' from otel.metrics_gauge where TimeUnix >= epoch_ms(${__from}) and TimeUnix < epoch_ms(${__to})\nunion all select time_bucket(to_milliseconds(${__interval_ms}), TimeUnix), 'metric points' from otel.metrics_sum where TimeUnix >= epoch_ms(${__from}) and TimeUnix < epoch_ms(${__to})\nunion all select time_bucket(to_milliseconds(${__interval_ms}), TimeUnix), 'metric points' from otel.metrics_histogram where TimeUnix >= epoch_ms(${__from}) and TimeUnix < epoch_ms(${__to})\n) group by all order by 1"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "signal",
              "text": "signal",
              "type": "string"
            },
            {
              "selector": "items",
              "text": "items",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "${__field.labels.signal}",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Telemetry by service",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "description": "Spans and log records, by the service that sent them.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "lake"
      },
      "interval": "5m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "lake"
          },
