            "data": "select time, service, count(*) as items from (\nselect time_bucket(to_milliseconds(${__interval_ms}), Timestamp) as time, ServiceName as service from otel.traces where Timestamp >= epoch_ms(${__from}) and Timestamp < epoch_ms(${__to})\nunion all select time_bucket(to_milliseconds(${__interval_ms}), Timestamp), ServiceName from otel.logs where Timestamp >= epoch_ms(${__from}) and Timestamp < epoch_ms(${__to})\n) group by all order by 1"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "service",
              "text": "service",
              "type": "string"
            },
            {
              "selector": "items",
              "text": "items",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "${__field.labels.service}",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Warnings and errors",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 9
      },
      "description": "What the stack's services logged as a warning or worse, the latest first.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "lake"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "lake"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "select Timestamp as time, ServiceName as service, SeverityText as severity, Body as message, TraceId as trace\nfrom otel.logs where SeverityNumber >= 13 and Timestamp >= epoch_ms(${__from}) and Timestamp < epoch_ms(${__to})\norder by Timestamp desc limit 500"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "service",
              "text": "service",
              "type": "string"
            },
            {
              "selector": "severity",
              "text": "severity",
              "type": "string"
            },
            {
              "selector": "message",
              "text": "message",
              "type": "string"
            },
            {
              "selector": "trace",
              "text": "trace",
              "type": "string"
            }
          ]
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "time": 0,
              "service": 1,
              "severity": 2,
              "message": 3,
              "trace": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "The log's answers",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "description": "How long the log takes to answer what writes to it (p99 of its Produce requests), and what of its write-ahead log it has yet to upload to the object store: the gateway answers an export only once the log has it.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "lake"
      },
      "interval": "5m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "lake"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "timeseries",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "select time_bucket(to_milliseconds(${__interval_ms}), TimeUnix) as time, 'produce, p99 (ms)' as measure, max(Value) as value from otel.metrics_gauge\nwhere ServiceName = 'log' and MetricName = 'kafka_request_time_99p_milliseconds' and Attributes['type'] = 'Produce' and TimeUnix >= epoch_ms(${__from}) and TimeUnix < epoch_ms(${__to})\ngroup by all\nunion all select time_bucket(to_milliseconds(${__interval_ms}), TimeUnix), 'write-ahead log to upload (MiB)', max(Value) / 1048576 from otel.metrics_gauge\nwhere ServiceName = 'log' and MetricName = 'kafka_stream_wal_pending_upload_bytes' and TimeUnix >= epoch_ms(${__from}) and TimeUnix < epoch_ms(${__to})\ngroup by all order by 1"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "measure",
              "text": "measure",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "value",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "${__field.labels.measure}",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Telemetry waiting in the log",
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "description": "Records of the stack's telemetry the lake's intake has yet to read, by topic, as it last asked the log: KEDA gives it another replica past 1,000 a partition, and it sleeps while none waits.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "lake"
      },
      "interval": "5m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "lake"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "timeseries",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "select time_bucket(to_milliseconds(${__interval_ms}), TimeUnix) as time, Attributes['topic'] as topic, max(Value) as value from otel.metrics_gauge\nwhere ServiceName = 'lake-intake' and MetricName = 'lake_telemetry_lag_records' and TimeUnix >= epoch_ms(${__from}) and TimeUnix < epoch_ms(${__to})\ngroup by all order by 1"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "topic",
              "text": "topic",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "value",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "displayName": "${__field.labels.topic}",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
