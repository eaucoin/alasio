          "format": "table",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "with latest as (\n  select Attributes['pod'] as server, MetricName as metric, Attributes['type'] as type, Attributes['collection'] as collection, arg_max(Value, TimeUnix) as value\n  from otel.metrics_gauge\n  where ServiceName = 'seaweedfs' and TimeUnix >= epoch_ms(${__from}) and TimeUnix < epoch_ms(${__to}) and MetricName in\n    ('SeaweedFS_volumeServer_resource', 'SeaweedFS_volumeServer_volumes', 'SeaweedFS_volumeServer_max_volumes', 'SeaweedFS_volumeServer_total_disk_size')\n  group by all)\nselect server,\n  sum(value) filter (where metric = 'SeaweedFS_volumeServer_volumes' and type = 'volume') as volumes,\n  max(value) filter (where metric = 'SeaweedFS_volumeServer_max_volumes') as most,\n  sum(value) filter (where metric = 'SeaweedFS_volumeServer_total_disk_size' and type = 'normal') as taken,\n  sum(value) filter (where metric = 'SeaweedFS_volumeServer_total_disk_size' and type = 'deleted_bytes') as deleted,\n  max(value) filter (where metric = 'SeaweedFS_volumeServer_resource' and type = 'free') as free,\n  max(value) filter (where metric = 'SeaweedFS_volumeServer_resource' and type = 'free') - max(value) filter (where metric = 'SeaweedFS_volumeServer_resource' and type = 'avail') as kept_free,\n  max(value) filter (where metric = 'SeaweedFS_volumeServer_resource' and type = 'avail') as to_fill\nfrom latest group by server order by server"
          },
