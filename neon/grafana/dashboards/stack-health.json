      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 8,
        "h": 8
      },
      "description": "The size of alasio's Neon's layers: those the pageserver keeps on its volume, and those it uploaded.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "lake"
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "lake"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "timeseries",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "select time_bucket(to_milliseconds(${__interval_ms}), TimeUnix) as time,\ncase MetricName when 'pageserver_resident_physical_size_global' then 'on its disk' else 'in the object store' end as size, max(Value) as bytes\nfrom otel.metrics_gauge\nwhere MetricName in ('pageserver_resident_physical_size_global', 'pageserver_remote_physical_size_global') and TimeUnix >= epoch_ms(${__from}) and TimeUnix < epoch_ms(${__to})\ngroup by all order by 1"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "size",
              "text": "size",
              "type": "string"
            },
            {
              "selector": "bytes",
              "text": "bytes",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "displayName": "${__field.labels.size}",
          "custom": {
