          "format": "table",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "select Timestamp as time, SpanAttributes['alasio.conversation.id'] as conversation, SpanAttributes['alasio.harness'] as harness,\ncoalesce(SpanAttributes['alasio.turn.outcome'], StatusCode) as outcome, Duration / 1e9 as duration, SpanAttributes['alasio.session.id'] as session,\nSpanAttributes['alasio.volume.id'] as workspace, TraceId as trace\nfrom otel.traces where SpanName = 'alasio.turn' and ServiceName = 'alasio' and coalesce(ResourceAttributes['alasio.branch'], 'main') = ${branch:sqlstring} and Timestamp >= epoch_ms(${__from}) and Timestamp < epoch_ms(${__to}) order by Timestamp desc limit 500"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "conversation",
              "text": "conversation",
              "type": "string"
            },
            {
              "selector": "harness",
              "text": "harness",
              "type": "string"
            },
            {
              "selector": "outcome",
              "text": "outcome",
              "type": "string"
            },
            {
              "selector": "duration",
              "text": "duration",
              "type": "number"
            },
            {
              "selector": "session",
              "text": "session",
              "type": "string"
            },
            {
              "selector": "workspace",
              "text": "workspace",
              "type": "string"
            },
            {
              "selector": "trace",
              "text": "trace",
              "type": "string"
            }
          ]
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "time": 0,
              "conversation": 1,
              "harness": 2,
              "outcome": 3,
              "duration": 4,
              "session": 5,
              "workspace": 6,
              "trace": 7
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "trace"
            },
            "properties": [
