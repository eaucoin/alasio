# Copy to .env (mode 0600). Never commit .env.
TELEGRAM_BOT_TOKEN=123456789:replace-with-the-token-from-BotFather
# Comma-separated numeric Telegram user IDs allowed to talk to the bot.
# Leave this set: with it empty the bot binds itself to whoever messages it first.
TELEGRAM_ALLOWED_USER_IDS=123456789

# Standalone instance isolation (keeps this bot apart from alasio.service).
ALASIO_STATE_DIR=/home/operator/.alasio-standalone
ALASIO_HOOK_PORT=8766

# Folders the operator may mount or create from /workspace must live directly under this root.
ALASIO_WORKSPACE_ROOT=/home/operator

# Optional pre-mounts. Leave unset for neutral-by-default (/service then /workspace pickers).
#ALASIO_DEFAULT_HARNESS=codex
#WORKING_DIRECTORY=/home/operator/monorepo

# Optional Claude Code overrides; default to the local claude CLI configuration.
#ALASIO_CLAUDE_MODEL=
#ALASIO_CLAUDE_EFFORT=
#ALASIO_CLAUDE_BIN=

# Session filesystems: an isolated, empty per-session JuiceFS volume in a gVisor
# sandbox, offered alongside local folders when the workspace is chosen. Off unless
# ENABLED=1. The Valkey (metadata) and the "sessions" S3 bucket live in alasio's Neon
# stack and are provisioned by its setup; the *_FILE paths below point at the secrets
# that setup materialises under ${ALASIO_STATE_DIR}/neon/secrets. Session hosts join the
# Neon compose project's network, so they reach both by service name. Claude Code and
# Codex run in alasio on the operator's own logins, as for folders, and reach a session
# only through its bayma, so no login is configured for them here.
#ALASIO_SANDBOX_ENABLED=1
#ALASIO_SANDBOX_NETWORK=alasio-neon_default
#ALASIO_SANDBOX_METADATA_URL=redis://valkey:6379
#ALASIO_SANDBOX_METADATA_PASSWORD_FILE=/home/operator/.alasio-standalone/neon/secrets/sandbox-metadata-password
#ALASIO_SANDBOX_S3_ENDPOINT=http://seaweedfs:8333
#ALASIO_SANDBOX_S3_BUCKET=sessions
#ALASIO_SANDBOX_S3_KEY_FILE=/home/operator/.alasio-standalone/neon/secrets/sandbox-s3-key
#ALASIO_SANDBOX_S3_SECRET_FILE=/home/operator/.alasio-standalone/neon/secrets/sandbox-s3-secret
# In "full" internet mode the drop list also blocks the host's own public IP; set it so
# a sandbox cannot reach the machine it runs on. Optional.
#ALASIO_SANDBOX_HOST_PUBLIC_IP=
# Per-session-host resource limits (defaults shown).
#ALASIO_SANDBOX_MEMORY_MB=2048
#ALASIO_SANDBOX_CPUS=2
#ALASIO_SANDBOX_PIDS=512
#ALASIO_SANDBOX_CACHE_MB=1024
