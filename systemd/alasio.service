[Unit]
Description=Alasio Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=operator
WorkingDirectory=/home/operator/monorepo-alasio-runtime/bots/alasio
EnvironmentFile=/home/operator/monorepo/bots/alasio/.env
Environment="PATH=/home/operator/.nvm/versions/node/v24.14.0/bin:/home/operator/.bun/bin:/home/operator/.local/bin:/usr/local/bin:/usr/bin:/bin:/snap/bin"
ExecStart=/home/operator/.nvm/versions/node/v24.14.0/bin/node ./src/index.js
OOMPolicy=continue
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
