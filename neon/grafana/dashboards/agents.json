      "interval": "5m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "lake"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "timeseries",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "select time, kind, sum(tokens) as tokens from (\nunpivot (select time_bucket(to_milliseconds(${__interval_ms}), occurred_at) as time, input_tokens - coalesce(cached_input_tokens, 0) as input, cached_input_tokens as \"cache read\",\noutput_tokens as output, reasoning_output_tokens as reasoning\nfrom codex.token_usage where ${branch:sqlstring} = 'main' and occurred_at >= epoch_ms(${__from}) and occurred_at < epoch_ms(${__to}))\non input, \"cache read\", output, reasoning into name kind value tokens)\ngroup by all order by 1"
