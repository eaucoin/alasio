            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "with points as (\n  select time_bucket(to_milliseconds(${__interval_ms}), TimeUnix) as time, Attributes['pod'] as server,\n  case MetricName when 'SeaweedFS_volumeServer_resource' then 'to fill' else 'deleted' end as what, Attributes['collection'] as collection, max(Value) as bytes\n  from otel.metrics_gauge\n  where ServiceName = 'seaweedfs' and TimeUnix >= epoch_ms(${__from}) and TimeUnix < epoch_ms(${__to})\n    and ((MetricName = 'SeaweedFS_volumeServer_resource' and Attributes['type'] = 'avail')\n      or (MetricName = 'SeaweedFS_volumeServer_total_disk_size' and Attributes['type'] = 'deleted_bytes'))\n  group by all)\nselect time, server || ' ' || what as space, sum(bytes) as bytes from points group by all order by 1"
