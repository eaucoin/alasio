// Installed to /etc/polkit-1/rules.d/50-alasio-standalone.rules by
// install-alasio-standalone-service.sh. Lets the bot, running as operator in its
// container, restart itself (and only itself) through the host's systemd, so
// restart-alasio-standalone.sh can record provenance and then restart the unit.
polkit.addRule(function (action, subject) {
  if (
    action.id === "org.freedesktop.systemd1.manage-units" &&
    action.lookup("unit") === "alasio-standalone.service" &&
    action.lookup("verb") === "restart" &&
    subject.user === "operator"
  ) {
    return polkit.Result.YES;
  }
});
