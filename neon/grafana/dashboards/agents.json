          "format": "timeseries",
          "url": "/query",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "select time_bucket(to_milliseconds(${__interval_ms}), Timestamp) as time, SpanAttributes['alasio.harness'] || ', median' as series, quantile_cont(Duration, 0.5) / 1e9 as seconds\nfrom otel.traces where SpanName = 'alasio.turn' and ServiceName = 'alasio' and coalesce(ResourceAttributes['alasio.branch'], 'main') = ${branch:sqlstring} and Timestamp >= epoch_ms(${__from}) and Timestamp < epoch_ms(${__to}) group by all\nunion all\nselect time_bucket(to_milliseconds(${__interval_ms}), Timestamp), SpanAttributes['alasio.harness'] || ', 95th percentile', quantile_cont(Duration, 0.95) / 1e9\nfrom otel.traces where SpanName = 'alasio.turn' and ServiceName = 'alasio' and coalesce(ResourceAttributes['alasio.branch'], 'main') = ${branch:sqlstring} and Timestamp >= epoch_ms(${__from}) and Timestamp < epoch_ms(${__to}) group by all\norder by 1"
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp"
            },
            {
