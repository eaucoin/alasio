# The environment alasio runs with. Its Helm chart (charts/alasio) sets all of it in the
# cluster; this file is for running alasio outside the cluster against one, in
# development. Copy to .env (mode 0600). Never commit .env.

TELEGRAM_BOT_TOKEN=123456789:replace-with-the-token-from-BotFather
# Comma-separated numeric Telegram user IDs allowed to talk to the bot.
# Leave this set: with it empty the bot binds itself to whoever messages it first.
TELEGRAM_ALLOWED_USER_IDS=123456789
# Another Bot API server (a self-hosted telegram-bot-api, say). Telegram's own unless set.
#TELEGRAM_API_ROOT=https://api.telegram.org

# What alasio makes workspaces from: the JSON the chart renders into its
# sandbox-templates ConfigMap (src/kube/config.ts). kubectl's current context is the
# cluster they are made in.
ALASIO_KUBE_TEMPLATES=/path/to/templates.json

# The database: the chart's Neon, through a port-forward to its compute, with the URL
# and the lake role's password from its database Secret.
#ALASIO_DATABASE_URL_FILE=
#ALASIO_LAKE_PASSWORD_FILE=
# The analytics lake (neon/lake/src/model.ts), which alasio grants its reads to. Off unless 1.
#ALASIO_LAKE_ENABLED=1

# Where alasio keeps its SQLite state and session filesystems' harness directories.
ALASIO_STATE_DIR=/home/operator/.alasio
# Folders the operator may mount or create from /workspace must live directly under this root.
ALASIO_WORKSPACE_ROOT=/home/operator

# Optional pre-mounts. Leave unset for neutral-by-default (/service then /workspace pickers).
#ALASIO_DEFAULT_HARNESS=codex
#WORKING_DIRECTORY=/home/operator/project

# Optional Claude Code overrides; default to the local claude CLI configuration. A
# long-lived token from `claude setup-token` logs Claude Code in where no ~/.claude does.
#ALASIO_CLAUDE_MODEL=
#ALASIO_CLAUDE_EFFORT=
#ALASIO_CLAUDE_BIN=
#CLAUDE_CODE_OAUTH_TOKEN=

# The Deployment alasio runs as, which its restart prompts and an agent's restart name.
#ALASIO_DEPLOYMENT=alasio
#ALASIO_NAMESPACE=alasio

# Telemetry: OpenTelemetry over OTLP to any backend, off unless an endpoint is set. Only
# the standard OTEL_* variables are read; Claude Code, Codex and bayma export theirs to
# the same place, sessions' through alasio's receiver, which the Service named here
# reaches.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
#OTEL_EXPORTER_OTLP_HEADERS=
#OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production
#ALASIO_TELEMETRY_RECEIVER_SERVICE=alasio-telemetry.alasio.svc
#ALASIO_TELEMETRY_RECEIVER_PORT=4318
