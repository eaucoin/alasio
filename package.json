{
  "name": "alasio-server",
  "version": "4.1.1",
  "private": true,
  "type": "module",
  "description": "alasio's server: the Telegram bridge that runs Claude Code and Codex, in alasio's image",
  "license": "MIT",
  "workspaces": [
    "cli"
  ],
  "main": "src/index.ts",
  "scripts": {
    "start": "node ./src/index.ts",
    "doctor:telegram": "node ./src/telegram/doctor.ts",
    "typecheck": "node tooling/codex-protocol-types.ts && tsc -p .",
    "test": "node --test test/*.test.ts cli/test/*.test.ts",
    "test:e2e": "node --test --test-timeout=1800000 test/e2e/alasio.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@effect/opentelemetry": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@kubernetes/client-node": "2.0.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@openai/codex-sdk": "0.153.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.35.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.0",
    "effect": "4.0.0",
    "import-in-the-middle": "^3.5.2",
    "pg": "^8.23.0"
  },
  "overrides": {
    "@hono/node-server": "2.1.3",
    "fast-uri": "3.1.8"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "@grammyjs/types": "^5.0.0",
    "@opentelemetry/otlp-transformer": "^0.222.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "protobufjs": "^7.6.6",
    "typescript": "7.0.2"
  }
}
