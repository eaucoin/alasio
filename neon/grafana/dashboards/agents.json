{
  "uid": "alasio-agents",
  "title": "Agents",
  "description": "Claude Code's and Codex's turns as alasio runs them, from its alasio.turn spans; the tokens they spend and the tools they call, from their transcripts; and a turn's trace, span by span. Main's, or a branch environment's turns, as Branch chooses.",
  "tags": [
    "alasio"
  ],
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "",
  "schemaVersion": 41,
  "templating": {
    "list": [
      {
        "name": "branch",
        "label": "Branch",
        "type": "query",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "lake"
        },
        "query": {
          "queryType": "infinity",
          "refId": "variable",
          "infinityQuery": {
            "refId": "A",
            "datasource": {
              "type": "yesoreyeram-infinity-datasource",
              "uid": "lake"
            },
            "type": "json",
            "source": "url",
            "parser": "backend",
            "format": "table",
            "url": "/query",
            "url_options": {
              "method": "POST",
              "body_type": "raw",
              "body_content_type": "text/plain",
              "data": "select * from (\nselect 'main' as __text, 'main' as __value\nunion\nselect distinct ResourceAttributes['alasio.branch'], ResourceAttributes['alasio.branch']\nfrom otel.traces where SpanName = 'alasio.turn' and ServiceName = 'alasio' and ResourceAttributes['alasio.branch'] is not null and Timestamp >= epoch_ms(${__from}) and Timestamp < epoch_ms(${__to})\n) order by __value <> 'main', __value"
            },
            "root_selector": "",
            "columns": [
              {
                "selector": "__text",
                "text": "__text",
                "type": "string"
              },
              {
                "selector": "__value",
                "text": "__value",
                "type": "string"
              }
            ]
          }
        },
        "refresh": 2,
        "description": "main, or a branch environment (alasio branch), whose telemetry is tagged alasio.branch. A branch's transcripts are in its own lake, which Grafana does not read: on a branch, tokens and tool calls show none.",
        "current": {
          "text": "main",
          "value": "main"
        }
      },
      {
        "name": "trace",
        "label": "Turn",
        "type": "query",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "lake"
        },
        "query": {
          "queryType": "infinity",
          "refId": "variable",
          "infinityQuery": {
            "refId": "A",
            "datasource": {
              "type": "yesoreyeram-infinity-datasource",
              "uid": "lake"
            },
            "type": "json",
            "source": "url",
            "parser": "backend",
            "format": "table",
            "url": "/query",
            "url_options": {
              "method": "POST",
              "body_type": "raw",
              "body_content_type": "text/plain",
              "data": "select strftime(Timestamp, '%Y-%m-%d %H:%M:%S') || ', ' || SpanAttributes['alasio.conversation.id'] || ', ' || coalesce(SpanAttributes['alasio.turn.outcome'], StatusCode) as __text,\nTraceId as __value\nfrom otel.traces where SpanName = 'alasio.turn' and ServiceName = 'alasio' and coalesce(ResourceAttributes['alasio.branch'], 'main') = ${branch:sqlstring} and Timestamp >= epoch_ms(${__from}) and Timestamp < epoch_ms(${__to}) order by Timestamp desc limit 200"
            },
            "root_selector": "",
            "columns": [
              {
                "selector": "__text",
                "text": "__text",
                "type": "string"
              },
              {
                "selector": "__value",
                "text": "__value",
                "type": "string"
              }
            ]
          }
        },
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
